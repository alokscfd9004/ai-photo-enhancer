# Copy this file to .env and adjust values.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Storage
MAX_UPLOAD_SIZE_MB=25
MAX_IMAGE_PIXELS=40000000

# Real-ESRGAN engine (filled in automatically by scripts/setup_realesrgan.py)
REALESRGAN_BINARY=bin/realesrgan-ncnn-vulkan
REALESRGAN_MODELS_DIR=bin/models
REALESRGAN_GPU_ID=-1
REALESRGAN_MAX_WORKERS=1
REALESRGAN_TIMEOUT_SECONDS=600

# Optional absolute URL prefix when behind a reverse proxy
# CSRF_TRUSTED_ORIGIN=https://photos.example.com
